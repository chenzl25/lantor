{
  "name": "lantor",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:web-math": "node tests/web-math.e2e.mjs",
    "dev": "vite --host 127.0.0.1",
    "web:backend": "cargo run --manifest-path src-tauri/Cargo.toml -- --web-only",
    "web:dev": "npm run build && npm run web:backend",
    "build": "tsc && vite build && node scripts/compress-web-assets.mjs",
    "build:bench": "tsc && vite build --mode bench && node scripts/compress-web-assets.mjs",
    "bench:composer": "node bench/composer-input-latency.mjs",
    "bench:composer:e2e": "node bench/composer-input-latency-e2e.mjs",
    "lint:css-tokens": "node scripts/check-raw-colors.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dicebear/adventurer": "^9.4.2",
    "@dicebear/bottts-neutral": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@dicebear/dylan": "^9.4.2",
    "@dicebear/identicon": "^9.4.2",
    "@dicebear/initials": "^9.4.2",
    "@dicebear/lorelei": "^9.4.2",
    "@dicebear/notionists": "^9.4.2",
    "@dicebear/personas": "^9.4.2",
    "@dicebear/pixel-art": "^9.4.2",
    "@dicebear/shapes": "^9.4.2",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@tauri-apps/api": "^2.5.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.508.0",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.60.0",
    "tsx": "^4.23.1",
    "vite": "^6.4.3"
  }
}
